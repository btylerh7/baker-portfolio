---
import { ClientRouter } from 'astro:transitions';
import Navbar from '../components/Navbar.svelte';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="theme-color" content="#1A1A2E" />
		<meta name="generator" content={Astro.generator} />
		<ClientRouter />
		<title>Tyler Baker's Internet Home</title>
	</head>
	<body>
		<slot />
		<Navbar />
	</body>
</html>

<style is:global>
	@import url('https://fonts.googleapis.com/css2?family=Cabin:ital,wght@0,400..700;1,400..700&display=swap');
	@font-face {
		font-family: 'Montserrat';
		src: url('/Montserrat-VariableFont.ttf') format('truetype-variations');
		font-weight: 400 700;
		font-display: swap;
	}
	*::before,
	*::after,
	* {
		box-sizing: border-box;
		/* font-family: 'Montserrat'; */
		font-family: 'Cabin', sans-serif;
		font-size: 17px;
		font-optical-sizing: auto;
		font-variation-settings: 'wdth' 100;
	}
	:root {
		--primary-bg-dark: hsl(260 28% 14%);
		--primary-bg: hsl(260 70% 50%);
		--primary-light: hsl(from var(--primary-bg) h s 80%);
	}
	html {
		scrollbar-gutter: stable;
		background: linear-gradient(
			to bottom,
			var(--primary-bg-dark),
			hsl(from var(--primary-bg-dark) h 30% 30%)
		);
	}
	body {
		width: 100%;
		height: 100%;
		min-height: 100vh;
		padding: 1rem;
		max-width: 1000px;
		margin-inline: auto;
	}
	a {
		color: white;
		:visited {
			color: white;
		}
	}
	main {
		padding: 1em;
		grid-area: main;
		color: white;
		height: 100%;
	}
</style>

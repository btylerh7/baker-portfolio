---
import fs from 'node:fs/promises';
const { filename } = Astro.props;
const fileText = await fs.readFile(`public/strudel/${filename}.js`, 'utf8');
---

<!---->
<script is:inline src="https://unpkg.com/@strudel/web@latest"></script>
<script is:inline src="https://unpkg.com/@strudel/repl@latest"></script>
<script>
	const editor = () => document.getElementById('repl') as any;
	const btn = () => document.getElementById('toggle-btn');
	let isPlaying = false;
	const onClick = () => {
		isPlaying = !isPlaying;
		const button = btn();
		if (button) {
			button.innerText = isPlaying ? 'Stop' : 'Play';
		}

		const repl = editor();
		repl.editor.toggle();
	};
	document.addEventListener('astro:page-load', () => {
		if (!editor()) return;
		isPlaying = false;
		btn()?.addEventListener('click', onClick);
	});
	document.addEventListener('astro:before-swap', () => {
		editor().editor.stop();
	});
</script>
<button id="toggle-btn">Play</button>
<strudel-editor id="repl">
	<Fragment set:html={`<!--\n${fileText}\n-->`} />
</strudel-editor>
<style>
	#toggle-btn {
		padding: 0.1rem 0.5rem;
		margin-bottom: 1em;
	}
</style>
